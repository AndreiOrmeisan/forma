# Frontend public configuration. Copy this value to frontend/.env.local.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend configuration. Set in the shell or copy to backend/.env.
# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local project persistence only. Defaults keep project CRUD disabled.
# To enable locally: FORMA_ENV=local and ENABLE_LOCAL_PROJECTS=true.
# Bind uvicorn to 127.0.0.1. Never enable these on a public deployment.
FORMA_ENV=production
ENABLE_LOCAL_PROJECTS=false
DATABASE_URL=sqlite:///./.local/forma.db

# Reserved for a future AI integration. Currently unused.
AI_API_KEY=
